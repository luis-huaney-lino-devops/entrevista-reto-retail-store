# Copia este archivo a .env.local y ajusta lo que necesites.
#
# Vite solo expone al navegador las variables que empiezan por VITE_. Cualquier
# otra queda fuera del bundle, que es justo lo que se quiere para un secreto.
#
# OJO: lo que empieza por VITE_ SÍ viaja al navegador y es público. Nunca pongas
# aquí una clave de API ni una contraseña.

# URL base de la API. Es el único sitio donde se configura contra qué backend
# habla el panel.
VITE_API_URL=http://localhost:8080/api/v1
