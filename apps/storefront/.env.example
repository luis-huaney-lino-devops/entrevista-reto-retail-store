# URL de la API vista desde el navegador. Todo lo que empieza por NEXT_PUBLIC_
# viaja al cliente en texto plano: aqui nunca va un secreto.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# URL de la API vista desde el servidor de Next. En Docker es la red interna
# (http://api:8080/api/v1) y no sale a internet. Sin prefijo NEXT_PUBLIC_
# justamente para que no pueda filtrarse al HTML.
API_URL_INTERNO=http://localhost:8080/api/v1

# Base de los enlaces absolutos: canonical, Open Graph y sitemap.
NEXT_PUBLIC_URL_TIENDA=http://localhost:3000

# Client id de Google Identity Services. Si queda vacio, el boton
# "Continuar con Google" no se pinta en vez de ensenar algo que va a fallar.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
