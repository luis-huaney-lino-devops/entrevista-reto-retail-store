# Variables del servicio Compose de Dokploy.
#
# Esto NO se copia a un archivo en el servidor: se pega tal cual en la pestana
# "Environment" del servicio en Dokploy, que es quien escribe el .env junto al
# compose antes de levantarlo.
#
# Por eso DB_CLAVE y JWT_SECRETO van vacios aqui: este archivo si esta en git.

# --------------------------------------------------------------- dominios ---
# Los tres tienen que ser subdominios del MISMO dominio registrable
# (algo.ejemplo.com), no dominios distintos. La cookie de refresco se emite con
# SameSite=Lax desde el dominio de la API; si la tienda vive en otro dominio
# registrable, el navegador deja de mandarla y la sesion se cae en cada
# recarga. Ver deploy/DOKPLOY.md.
DOMINIO_TIENDA=tienda.tudominio.com
DOMINIO_ADMIN=admin.tudominio.com
DOMINIO_API=api.tudominio.com

# ---------------------------------------------- base de datos (ya existe) ---
# El host es el nombre del contenedor del servicio Postgres de Dokploy, tal y
# como aparece en su cadena de conexion interna.
DB_HOST=entrevista-storebasededatos-fjl4k6
DB_PUERTO=5432
DB_NOMBRE=store-db
DB_USUARIO=postgres
DB_CLAVE=

# --------------------------------------------------------------- secretos ---
# Minimo 32 bytes. Generar con:  openssl rand -base64 48
# Cambiarlo invalida todas las sesiones abiertas, que es justo lo que se quiere
# si alguna vez se filtra.
JWT_SECRETO=

# --------------------------------------------------------- correo saliente ---
# Clave de Resend (https://resend.com/api-keys). VACIA DESACTIVA EL ENVIO: la
# aplicacion arranca igual y cada correo se registra en el log. Util en local,
# pero en produccion sin esto no sale ni la bienvenida ni la recuperacion.
#
# Al arrancar, si falta, la API lo dice en el log:
#   "app.correo.api-key vacia: los correos se registraran en el log"
RESEND_API_KEY=

# El dominio tiene que estar verificado en Resend o la API responde 403.
CORREO_REMITENTE=Retail Store <no-reply@tutec.pe>

# ------------------------------------------------------------------ Google ---
# Client ID de OAuth (consola de Google -> Credenciales -> Aplicacion web).
# NO hace falta client secret: el flujo es Identity Services con ID token y el
# backend solo verifica la firma contra las claves publicas de Google.
#
# En la consola, "Origenes autorizados de JavaScript" son los dominios exactos
# sin ruta ni barra final; "URIs de redireccion" se deja VACIO.
#
# Vacio = el boton "Continuar con Google" no se pinta, en vez de pintarse y
# fallar. La API responde 503 GOOGLE_NOT_CONFIGURED si se la llama igualmente.
GOOGLE_CLIENT_ID=

# --------------------------------------------------------------- opcional ---
# 'local' guarda las imagenes en el volumen del contenedor de la API. 'r2' usa
# Cloudflare R2 (ADR-0009) y entonces hay que rellenar las cuatro R2_*.
ALMACEN_TIPO=local

# Solo con ALMACEN_TIPO=r2: el dominio publico del bucket, el mismo de
# ALMACEN_URL_PUBLICA. Autoriza a next/image a traer las fotos de ahi. Se lee
# AL CONSTRUIR la tienda, asi que cambiarlo obliga a redesplegar, no a
# reiniciar.
NEXT_PUBLIC_CDN_URL=

R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

TZ=America/Lima

# Nombre del certificate resolver de Traefik. En una instalacion estandar de
# Dokploy es 'letsencrypt' y no hay que tocarlo.
TRAEFIK_CERT_RESOLVER=letsencrypt
